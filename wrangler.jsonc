  "durable_objects": { "bindings": [{ "name": "SECURITY", "class_name": "SecurityState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SecurityState"] }],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "TOTAL_CAP_BYTES": "8589934592", "R2_BUCKET": "private", "R2_ACCOUNT_ID": "52cb42aafc8a0866641df0d3f6306b2e", "SENDER_NAME": "private vault", "TURNSTILE_SITE_KEY": "0x4AAAAAAGLVWUFT3v5G8sB7" }
