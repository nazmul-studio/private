# Copy to .dev.vars for local development (`wrangler dev`). .dev.vars is git-ignored.
# For production set each of these as a Cloudflare Worker Secret: `npx wrangler secret put <NAME>`
# Every value below is a placeholder. Never put real values in this file.

# Required: long random string; also the emergency lockdown reset key
SETUP_TOKEN=change-me-to-a-long-random-string

# Email (Brevo)
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=verified-sender@example.com
LOGIN_EMAIL=login@example.com
SECURITY_EMAIL=security@example.com

# Cloudflare Turnstile secret key (site key is a public var in wrangler.jsonc)
TURNSTILE_SECRET=your-turnstile-secret-key

# R2 S3-API token limited to Object Read & Write on bucket "private" (used for presigned multipart video uploads)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional: random string used as the key when hashing IP addresses in the login history and rate limiter.
# If unset, SETUP_TOKEN is used. Changing it only changes how new log entries are hashed.
AUDIT_SALT=any-long-random-string
