{
  "name": "private",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/limits.test.mjs tests/security.test.mjs tests/webauthn.test.mjs",
    "migrate": "wrangler d1 migrations apply private --remote",
    "migrate:local": "wrangler d1 migrations apply private --local",
    "build:css": "node tools/build-css.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5",
    "wrangler": "^4",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "aws4fetch": "^1"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
